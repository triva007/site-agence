{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "atlas.notlegal.fr"
        }
      ],
      "destination": "/atlas/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "guesslendroit.vercel.app"
        }
      ],
      "destination": "/atlas/",
      "permanent": false
    },
    {
      "source": "/jeu",
      "destination": "/atlas/",
      "permanent": false
    },
    {
      "source": "/jeu/:path*",
      "destination": "/atlas/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/atlas/relais/:topic(pdc-[a-z2-9]{6})",
      "destination": "https://ntfy.sh/:topic"
    },
    {
      "source": "/atlas/relais/:topic(pdc-[a-z2-9]{6})/:rest*",
      "destination": "https://ntfy.sh/:topic/:rest*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
